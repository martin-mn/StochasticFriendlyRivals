   q = 1000 [Grim]                margin(p,q) + margin(m(p),m(q)) = 0
   q = 1001 [WSLS]                margin(p,q) + margin(m(p),m(q)) = 0
   q = 1010 [TFT]                 margin(p,q) + margin(m(p),m(q)) = 0
   q = 1011                       margin(p,q) + margin(m(p),m(q)) = 0
   q = 1100                       margin(p,q) + margin(m(p),m(q)) = 0
   q = 1101                       margin(p,q) + margin(m(p),m(q)) = 0
