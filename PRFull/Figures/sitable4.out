##############################################################################################################
HOW EACH ROW IS COMPUTED
  med_eff      np.median(E) over the 512 games; E = mean per-round payoff / Emax
  n_lt09       #games with E < 0.9
  n_neg        #games with E < 0 (Emax > 0, so E < 0 iff the mean payoff is negative)
  med_eff_pd   np.median(E) over the 129 PD games (games.dat tag PD: u<0<v)
  pd_partner   #PD games whose most abundant atom is 110 or 111
  above_eff    #games of wedges N, E (u+v>1; 207) whose most abundant atom is 100, 110 or 111
  s_111        #games of wedge S (126) whose most abundant atom is 111
  s_111_share  np.median(S[:, 111]) over the 126 games of S
  out_111      #games outside S (386) whose most abundant atom is 111
  med_comp     np.median over 512 games of the share of 001 + 011 + 111 (fig45 PS[:, 2])
  mean_eff     mean over 512 games of the share of 100 + 110 + 111
  mean_stab    mean over 512 games of the share of 010 + 110 + 011 + 111
  mean_comp    mean over 512 games of the share of 001 + 011 + 111
  agree10      #games at which every replicate's own most abundant atom (argmax of its 7 atom shares) is the pooled leader
  leading atom: fig4.winners (binary), fig4c.continuous (memory-one cube), figwfc.winners_c (memory-two cube)
  shares PS: fig45 (sums of the atom shares S over the atoms of each property, fig5.PROPS)
  table formatting: counts as integers; efficiencies to 3 decimals; shares to 3 decimals, below 0.01 to 2 significant digits

